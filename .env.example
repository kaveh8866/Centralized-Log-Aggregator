# =============================================================================
# Centralized Log Aggregator — environment template
# =============================================================================
# Copy to `.env` (never committed), fill in real values, then:
#   docker compose --env-file .env -f docker/docker-compose.yml up -d
#
# Every value below is a placeholder. No real credential belongs in this file.

# --- Grafana (UI on port 3000) ----------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=your_grafana_admin_password_here
GRAFANA_ROOT_URL=http://localhost:3000
GRAFANA_PORT=3000

# --- Loki (log store, port 3100) --------------------------------------------
LOKI_PORT=3100

# --- Fluent Bit (collector + loopback metrics on 2020) ----------------------
FLUENT_BIT_HTTP_PORT=2020
LOG_HOST_LABEL=your_host_label_here
LOG_CLUSTER_LABEL=cloudguard-logs

# --- OCI (Stage 2 / Terraform — not read by the compose stack) --------------
OCI_REGION=eu-frankfurt-1
OCI_TENANCY_OCID=your_tenancy_ocid_here
OCI_USER_OCID=your_user_ocid_here
OCI_FINGERPRINT=your_api_key_fingerprint_here
OCI_COMPARTMENT_OCID=your_compartment_ocid_here
OCI_SSH_PUBLIC_KEY_PATH=./keys/oci_public_key.pub
